{
  "name": "doctor-clinic-portal",
  "version": "0.0.1",
  "private": true,
  "description": "A comprehensive clinic management application built with React Native",
  "keywords": [
    "react-native",
    "clinic",
    "healthcare",
    "mobile",
    "typescript"
  ],
  "homepage": "https://github.com/devamitch/doctor-clinic-portal#readme",
  "bugs": {
    "url": "https://github.com/yourusername/myclinic/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/myclinic.git"
  },
  "license": "MIT",
  "author": {
    "name": "Amit Chakraborty",
    "email": "amit98ch@gmail.com",
    "url": "https://github.com/devamitch"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator='iPhone 16 Pro Max'",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace MyClinic.xcworkspace -scheme MyClinic -configuration Release -destination generic/platform=iOS -archivePath MyClinic.xcarchive archive",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "lint": "eslint . --cache --fix --max-warnings 0 --no-warn-ignored",
    "lint:check": "eslint . --cache --max-warnings 0 --no-warn-ignored",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "validate": "npm-run-all --parallel type-check lint:check format:check test:ci",
    "validate:fix": "npm-run-all --sequential format lint type-check test:ci",
    "clean": "react-native clean-project-auto",
    "clean:all": "npm run clean && rm -rf node_modules && npm install",
    "reset": "npm run clean && npm run start:reset",
    "pod-install": "cd ios && pod install",
    "prepare": "husky install",
    "postinstall": "patch-package",
    "security:audit": "npm audit --audit-level moderate",
    "security:check": "npm run security:audit && npm run deps:check",
    "deps:check": "npx depcheck",
    "deps:update": "npx npm-check-updates -u",
    "docs:generate": "typedoc --out docs src",
    "docs:serve": "npx http-server docs -p 8080",
    "bundle:analyze": "npx react-native-bundle-visualizer",
    "perf:profile": "npx react-native run-ios --configuration Release",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
